# Canonical host and HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://alphaprofitness.in%{REQUEST_URI} [R=301,L]

# Custom 404 page generated by Astro
ErrorDocument 404 /404.html

# Long-lived cache for fingerprinted assets and self-hosted fonts
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
