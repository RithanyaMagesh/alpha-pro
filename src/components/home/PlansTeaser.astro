---
import Button from '../Button.astro';
---

<section class="teaser-band" aria-labelledby="plans-teaser-h2">
  <div class="container teaser-wrap">
    <div class="teaser-copy">
      <h2 id="plans-teaser-h2" class="section-h2 teaser-h2">
        MEMBERSHIP FROM ₹2,500 A MONTH.
      </h2>
      <p class="teaser-text">
        Or ₹12,000 for the full year. Same floor, same coaches on every plan.
      </p>
    </div>
    <div class="teaser-acts">
      <Button href="/membership" variant="primary" size="default" arrow>
        See membership
      </Button>
      <Button href="/membership#compare" variant="outline" size="default">
        Compare plans
      </Button>
    </div>
  </div>
</section>

<style>
  .teaser-band {
    border-block: 1px solid var(--line);
    padding: clamp(44px, 6vw, 56px) 0;
    background: transparent;
  }

  .teaser-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .teaser-copy {
    min-width: 0;
  }

  .teaser-h2 {
    margin: 0;
    font-size: clamp(28px, 3.8vw, 40px);
  }

  .teaser-text {
    color: var(--mute);
    margin-top: 10px;
  }

  .teaser-acts {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 10px;
    flex-shrink: 0;
  }

  .teaser-acts :global(.btn) {
    width: 100%;
    justify-content: space-between;
  }

  @media (min-width: 480px) {
    .teaser-acts {
      flex-direction: row;
      width: auto;
      gap: 14px;
    }

    .teaser-acts :global(.btn) {
      width: auto;
      justify-content: center;
    }
  }

  @media (min-width: 1024px) {
    .teaser-wrap {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }
  }
</style>
