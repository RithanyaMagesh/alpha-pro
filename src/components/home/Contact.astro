---
import { siteConfig } from '../../data/site';
---

<section class="contact-section" id="contact" aria-labelledby="contact-h2">
  <div class="container">
    <h2 id="contact-h2" class="display-title section-h2 contact-h2">
      GET IN TOUCH AND START YOUR FITNESS JOURNEY
    </h2>

    <div class="contact-grid">
      <div class="contact-col cinfo">
        <a href={`tel:${siteConfig.phoneTel}`} class="cinfo-row">
          <svg
            class="cinfo-ico"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          <div class="cinfo-body">
            <span>Call</span>
            <b class="big">{siteConfig.phoneDisplay}</b>
          </div>
        </a>

        <a
          href={siteConfig.whatsAppUrl}
          target="_blank"
          rel="noopener"
          class="cinfo-row"
        >
          <svg
            class="cinfo-ico"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 21l1.6-4.5A9 9 0 1 1 12 21a9 9 0 0 1-4.4-1.2z" />
          </svg>
          <div class="cinfo-body">
            <span>WhatsApp</span>
            <b class="big">{siteConfig.phoneDisplay}</b>
          </div>
        </a>

        <div class="cinfo-row cinfo-address">
          <svg
            class="cinfo-ico"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <div class="cinfo-body">
            <span>Address</span>
            <b>{siteConfig.addressLines.join(' ')}</b>
          </div>
        </div>

        <a
          href={siteConfig.instagramUrl}
          target="_blank"
          rel="noopener"
          class="cinfo-row"
        >
          <svg
            class="cinfo-ico"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
          </svg>
          <div class="cinfo-body">
            <span>Instagram</span>
            <b>{siteConfig.instagramHandle} ↗</b>
          </div>
        </a>
      </div>

      <a
        class="contact-col map-panel"
        href={siteConfig.mapsUrl}
        target="_blank"
        rel="noopener"
        aria-label="Directions on Google Maps"
      >
        <svg
          class="map-svg"
          viewBox="0 0 600 360"
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
        >
          <g stroke="#262626" stroke-width="10" fill="none">
            <path d="M-20 90 L620 60"></path>
            <path d="M-20 250 L620 290"></path>
            <path d="M180 -20 L230 380"></path>
            <path d="M430 -20 L390 380"></path>
          </g>
          <g stroke="#1b1b1b" stroke-width="4" fill="none">
            <path d="M-20 170 L620 175"></path>
            <path d="M80 -20 L110 380"></path>
            <path d="M310 -20 L320 380"></path>
            <path d="M520 -20 L500 380"></path>
            <path d="M-20 330 L620 320"></path>
          </g>
          <path
            d="M230 175 L320 172 L325 120"
            stroke="var(--lime)"
            stroke-width="3"
            fill="none"
            stroke-dasharray="6 6"
          ></path>
        </svg>

        <div class="pin" aria-hidden="true">
          <span>ALPHAPRO FITNESS</span>
          <i></i>
        </div>

        <span class="dir">Directions on Google Maps ↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding-block: clamp(64px, 9vw, 110px);
    background: transparent;
  }

  .contact-h2 {
    max-width: 24ch;
    text-wrap: balance;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-top: 28px;
  }

  .contact-col {
    min-width: 0;
  }

  .cinfo {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    align-content: start;
  }

  .cinfo-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .cinfo-ico {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--steel);
    transition: color 0.2s ease;
  }

  .cinfo-row:hover .cinfo-ico {
    color: var(--lime);
  }

  .cinfo-body {
    min-width: 0;
  }

  .cinfo-body span {
    display: block;
    font-size: 13px;
    color: var(--mute);
    text-transform: none;
    letter-spacing: normal;
  }

  .cinfo-body b {
    display: block;
    font-weight: 500;
    font-size: 17px;
    margin-top: 4px;
    line-height: 1.4;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .cinfo-body b.big {
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(22px, 2.6vw, 26px);
    color: var(--ink);
  }

  a.cinfo-row:hover .cinfo-body b {
    color: var(--lime);
  }

  /* Map Panel */
  .map-panel {
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    background: var(--surf);
    overflow: hidden;
    text-decoration: none;
  }

  .map-panel:hover .dir {
    border-color: var(--lime);
    color: var(--lime);
  }

  .map-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pin {
    position: absolute;
    left: 54%;
    top: 46%;
    transform: translate(-50%, -100%);
    display: grid;
    justify-items: center;
    pointer-events: none;
  }

  .pin i {
    width: 20px;
    height: 20px;
    background: var(--lime);
    transform: rotate(45deg);
    border-radius: 2px;
  }

  .pin span {
    margin-bottom: 22px;
    background: var(--lime);
    color: #0a0a0a;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 12px;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .dir {
    position: absolute;
    left: 16px;
    bottom: 16px;
    font-size: 13px;
    color: var(--ink);
    background: #070707;
    border: 1px solid var(--line);
    padding: 10px 14px;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  @media (min-width: 480px) {
    .cinfo {
      grid-template-columns: 1fr 1fr;
      gap: 30px 36px;
    }
  }

  @media (min-width: 641px) {
    .contact-section {
      padding-block: clamp(56px, 11vh, 120px);
      padding-block: clamp(56px, 11svh, 120px);
    }
  }

  @media (min-width: 768px) {
    .map-panel {
      aspect-ratio: 16 / 10;
    }
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      margin-top: 40px;
    }

    .cinfo {
      gap: 34px 40px;
    }

    .map-panel {
      aspect-ratio: 16 / 10;
      min-height: 360px;
    }

    .dir {
      left: 20px;
      bottom: 20px;
    }
  }
</style>
