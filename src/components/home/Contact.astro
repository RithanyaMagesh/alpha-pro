---
import { siteConfig } from '../../data/site';
---

<section class="contact-section" id="contact" aria-labelledby="contact-h2">
  <div class="container">
    <h2 id="contact-h2" class="section-h2">COME SAY HI</h2>

    <div class="contact-grid">
      <div class="contact-col cinfo">
        <div class="cinfo-item address-item">
          <span>Address</span>
          <b>
            {siteConfig.addressLines[0]}<br />
            {siteConfig.addressLines[1]}
          </b>
        </div>

        <div class="cinfo-item">
          <span>Call or WhatsApp</span>
          <a
            href={siteConfig.whatsAppUrl}
            target="_blank"
            rel="noopener"
            class="phone-link"
          >
            <b class="big">{siteConfig.phoneDisplay}</b>
          </a>
          <a
            href={siteConfig.whatsAppUrl}
            target="_blank"
            rel="noopener"
            class="wa-chat-link"
          >
            Chat on WhatsApp ↗
          </a>
        </div>

        <div class="cinfo-item">
          <span>Parking</span>
          <b>{siteConfig.parking}</b>
        </div>

        <div class="cinfo-item">
          <span>Instagram</span>
          <a
            href={siteConfig.instagramUrl}
            target="_blank"
            rel="noopener"
            class="ig-link"
          >
            <b>{siteConfig.instagramHandle} ↗</b>
          </a>
        </div>
      </div>

      <a
        class="contact-col map-panel"
        href={siteConfig.mapsUrl}
        target="_blank"
        rel="noopener"
        aria-label="Directions on Google Maps"
      >
        <svg
          class="map-svg"
          viewBox="0 0 600 360"
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
        >
          <g stroke="#262626" stroke-width="10" fill="none">
            <path d="M-20 90 L620 60"></path>
            <path d="M-20 250 L620 290"></path>
            <path d="M180 -20 L230 380"></path>
            <path d="M430 -20 L390 380"></path>
          </g>
          <g stroke="#1b1b1b" stroke-width="4" fill="none">
            <path d="M-20 170 L620 175"></path>
            <path d="M80 -20 L110 380"></path>
            <path d="M310 -20 L320 380"></path>
            <path d="M520 -20 L500 380"></path>
            <path d="M-20 330 L620 320"></path>
          </g>
          <path
            d="M230 175 L320 172 L325 120"
            stroke="var(--lime)"
            stroke-width="3"
            fill="none"
            stroke-dasharray="6 6"
          ></path>
        </svg>

        <div class="pin" aria-hidden="true">
          <span>ALPHA PRO FITNESS</span>
          <i></i>
        </div>

        <span class="dir">Directions on Google Maps ↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding-block: clamp(64px, 9vw, 110px);
    background: transparent;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-top: 28px;
  }

  .contact-col {
    min-width: 0;
  }

  .cinfo {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .cinfo-item {
    min-width: 0;
  }

  .address-item {
    grid-column: 1 / -1;
  }

  .cinfo-item span {
    display: block;
    font-size: 13px;
    color: var(--mute);
    text-transform: none;
    letter-spacing: normal;
  }

  .cinfo-item b {
    display: block;
    font-weight: 500;
    font-size: 17px;
    margin-top: 8px;
    line-height: 1.4;
    color: var(--ink);
  }

  .cinfo-item b.big {
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(24px, 3vw, 28px);
    color: var(--ink);
  }

  .phone-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  .phone-link:hover b.big {
    color: var(--lime);
  }

  .wa-chat-link {
    display: inline-block;
    margin-top: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--lime);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ig-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  .ig-link:hover b {
    color: var(--lime);
  }

  /* Map Panel */
  .map-panel {
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    background: var(--surf);
    overflow: hidden;
    text-decoration: none;
  }

  .map-panel:hover .dir {
    border-color: var(--lime);
    color: var(--lime);
  }

  .map-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pin {
    position: absolute;
    left: 54%;
    top: 46%;
    transform: translate(-50%, -100%);
    display: grid;
    justify-items: center;
    pointer-events: none;
  }

  .pin i {
    width: 20px;
    height: 20px;
    background: var(--lime);
    transform: rotate(45deg);
    border-radius: 2px;
  }

  .pin span {
    margin-bottom: 22px;
    background: var(--lime);
    color: #0a0a0a;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 12px;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .dir {
    position: absolute;
    left: 16px;
    bottom: 16px;
    font-size: 13px;
    color: var(--ink);
    background: #070707;
    border: 1px solid var(--line);
    padding: 10px 14px;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  @media (min-width: 480px) {
    .cinfo {
      grid-template-columns: 1fr 1fr;
      gap: 30px 36px;
    }
  }

  @media (min-width: 641px) {
    .contact-section {
      padding-block: clamp(56px, 11vh, 120px);
      padding-block: clamp(56px, 11svh, 120px);
    }
  }

  @media (min-width: 768px) {
    .map-panel {
      aspect-ratio: 16 / 10;
    }
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      margin-top: 40px;
    }

    .cinfo {
      gap: 34px 40px;
    }

    .map-panel {
      aspect-ratio: 16 / 10;
      min-height: 360px;
    }

    .dir {
      left: 20px;
      bottom: 20px;
    }
  }
</style>
