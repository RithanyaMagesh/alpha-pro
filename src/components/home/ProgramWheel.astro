---
import { Image } from 'astro:assets';
import { programs } from '../../data/programs';

import strengthImg from '../../assets/photos/strength.jpg';
import personalImg from '../../assets/photos/personal.jpg';
import crossfitImg from '../../assets/photos/crossfit.jpg';
import bodybuildingImg from '../../assets/photos/bodybuilding.jpg';
import weightImg from '../../assets/photos/weight.jpg';
import nutritionImg from '../../assets/photos/nutrition.jpg';
import cardioImg from '../../assets/photos/cardio.jpg';
import aerobicsImg from '../../assets/photos/aerobics.jpg';

const photoMap: Record<string, ImageMetadata> = {
  strength: strengthImg,
  personal: personalImg,
  crossfit: crossfitImg,
  bodybuilding: bodybuildingImg,
  weight: weightImg,
  nutrition: nutritionImg,
  cardio: cardioImg,
  aerobics: aerobicsImg,
};

const defaultIndex = 2;
const defaultProg = programs[defaultIndex]!;
---

<section class="wheel-section" id="programs" aria-labelledby="wheel-heading">
  <div class="container wheel-grid">
    <!-- Left Column -->
    <div class="wheel-col wheel-left">
      <span class="section-label">Spin the wheel or pick one below</span>
      <h2 id="wheel-heading" class="section-h2">8 WAYS TO TRAIN.</h2>
      <p class="wheel-intro">
        Eight ways to train on one floor. Scroll or drag the wheel. Tell a coach
        your goal and they'll put you on the right one.
      </p>
      <div class="pbar" id="w-bar" aria-label="Program progress indicator"></div>
    </div>

    <!-- Centre Column (Dial) -->
    <div
      class="wheel-col dial"
      id="dial"
      tabindex="0"
      role="group"
      aria-label="Program wheel. Use arrow keys to spin."
    >
      <div class="marker" aria-hidden="true"></div>
      <div class="ring" id="ring" aria-hidden="true"></div>
      <div class="wheel-labels" id="w-labels"></div>
      <div class="photo" id="w-photo">
        {
          programs.map((prog, i) => (
            <Image
              src={photoMap[prog.photo]!}
              alt={prog.name}
              class:list={['bw-photo', 'wheel-photo-img', { on: i === defaultIndex }]}
              widths={[320, 560]}
              sizes="(min-width: 768px) 560px, 82vw"
              width={560}
              height={560}
              format="webp"
              loading="lazy"
            />
          ))
        }
      </div>
      <div class="spin" aria-hidden="true">↻ &nbsp;Scroll to spin</div>
    </div>

    <!-- Right Column (Details) -->
    <div class="wheel-col wheel-right">
      <div class="idx" id="w-idx">03 / 08</div>
      <h3 class="prog-title" id="w-name">{defaultProg.name}</h3>
      <p class="prog-desc" id="w-desc">{defaultProg.description}</p>
      <div class="prog-tags" id="w-tags">
        {defaultProg.tags.map((tag) => <span>{tag}</span>)}
      </div>
      <div class="prog-ctl">
        <button
          type="button"
          class="circ"
          id="w-prev"
          aria-label="Previous program"
        >
          <svg
            class="arr"
            style="transform: scaleX(-1)"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 12h15M13 6l6 6-6 6"></path>
          </svg>
        </button>
        <button
          type="button"
          class="circ on"
          id="w-next"
          aria-label="Next program"
        >
          <svg
            class="arr"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 12h15M13 6l6 6-6 6"></path>
          </svg>
        </button>
        <a href="#book" class="try-link" data-try>
          Try it free
          <svg
            class="arr"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 12h15M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Photo Tiles -->
  <div class="container">
    <div class="pstrip wheel-strip" id="w-strip" role="tablist" aria-label="Programs list">
      {
        programs.map((prog, i) => (
          <button
            type="button"
            class:list={['pt', 'program-tile', { on: i === defaultIndex }]}
            role="tab"
            aria-selected={i === defaultIndex ? 'true' : 'false'}
            aria-label={prog.name}
          >
            <Image
              src={photoMap[prog.photo]!}
              alt=""
              class="bw-photo"
              widths={[200, 320]}
              sizes="(min-width: 1280px) 160px, (min-width: 768px) 24vw, 128px"
              width={200}
              height={150}
              format="webp"
              loading="lazy"
            />
            <span>{prog.name}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<style>
  .wheel-section {
    position: relative;
    padding-block: clamp(64px, 9vw, 130px);
    background: transparent;
    overflow: hidden;
  }

  .wheel-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    justify-items: center;
    text-align: center;
    align-items: center;
  }

  .wheel-col,
  .wheel-left,
  .wheel-right {
    min-width: 0;
  }

  .wheel-intro {
    display: none;
    color: var(--mute);
    margin-top: 20px;
    max-width: 30ch;
    line-height: 1.55;
  }

  /* Progress bar */
  :global(.pbar) {
    display: none;
    gap: 6px;
    margin-top: 36px;
    align-items: center;
  }

  :global(.pbar button) {
    width: 28px;
    height: 14px;
    display: grid;
    align-items: center;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  :global(.pbar button i) {
    display: block;
    height: 3px;
    background: rgba(255, 255, 255, 0.15);
    transition: background-color 0.3s ease;
  }

  :global(.pbar button.d i) {
    background: var(--lime);
  }

  :global(.pbar .pbar-counter) {
    white-space: nowrap;
    margin-left: 12px;
    font-size: 11px;
    letter-spacing: 0.14em;
    font-weight: 600;
    color: var(--steel);
  }

  /* Dial */
  .dial {
    --d: min(64vw, 300px);
    position: relative;
    width: var(--d);
    height: var(--d);
    margin-block: 44px 56px;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    outline: none;
  }

  .dial.drag {
    cursor: grabbing;
  }

  .dial:focus-visible :global(.ring) {
    border-color: var(--lime);
  }

  :global(.ring) {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    transform: rotate(-90deg);
  }

  :global(.ring .t) {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 10px;
    background: rgba(255, 255, 255, 0.22);
    transform-origin: 0 calc(var(--d) / 2);
  }

  :global(.ring .t.m) {
    height: 18px;
    background: rgba(255, 255, 255, 0.4);
  }

  .wheel-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
  }

  .wheel-labels :global(.nm) {
    position: absolute;
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px 3px;
    font-size: 10px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: none;
    white-space: nowrap;
    color: #7d8084;
    pointer-events: auto;
    transition: color 0.3s ease;
  }

  .wheel-labels :global(.nm:hover) {
    color: var(--ink);
  }

  .wheel-labels :global(.nm.on) {
    color: var(--lime);
    font-weight: 700;
  }

  .marker {
    position: absolute;
    left: 50%;
    top: -8px;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    background: var(--lime);
    transform: rotate(45deg);
    border-radius: 2px;
    z-index: 3;
  }

  .spin {
    position: absolute;
    left: 50%;
    bottom: -52px;
    transform: translateX(-50%);
    font-size: 13px;
    color: var(--steel);
    white-space: nowrap;
  }

  .photo {
    position: absolute;
    inset: 9%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line), 0 40px 80px -30px #000;
  }

  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 50%,
      transparent 55%,
      rgba(0, 0, 0, 0.55)
    );
    pointer-events: none;
  }

  .wheel-photo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.1);
    transition: opacity 0.7s ease,
      transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .wheel-photo-img.on {
    opacity: 1;
    transform: none;
  }

  /* Right column */
  .wheel-right {
    display: grid;
    justify-items: center;
    width: 100%;
    container-type: inline-size;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .wheel-right.out {
    opacity: 0;
    transform: translateY(8px);
  }

  .idx {
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-size: 18px;
    color: var(--steel);
  }

  .prog-title {
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-style: italic;
    font-size: clamp(22px, 3.6vw, 46px);
    line-height: 1;
    margin-top: 14px;
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: normal;
    hyphens: none;
    max-width: 100%;
    color: var(--ink);
  }

  @supports (font-size: 1cqi) {
    .prog-title {
      font-size: clamp(22px, 9.8cqi, 46px);
    }
  }

  .prog-desc {
    color: var(--mute);
    margin-top: 18px;
    max-width: 34ch;
    line-height: 1.55;
  }

  .prog-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 22px;
  }

  .prog-tags :global(span) {
    font-size: 13px;
    border: 1px solid var(--line);
    padding: 7px 12px;
    color: #cfd0cc;
  }

  .prog-ctl {
    display: flex;
    gap: 10px;
    margin-top: 30px;
    align-items: center;
    justify-content: center;
  }

  .circ {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.25);
    display: grid;
    place-items: center;
    color: var(--ink);
    cursor: pointer;
    background: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .circ:hover {
    border-color: var(--lime);
    color: var(--lime);
  }

  .circ.on {
    border-color: var(--lime);
    color: var(--lime);
  }

  .arr {
    width: 16px;
    height: 16px;
  }

  .try-link {
    margin-left: 14px;
    color: var(--ink);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    transition: color 0.2s ease;
  }

  .try-link:hover {
    color: var(--lime);
  }

  /* Bottom Tiles Row: horizontal scroll-snap on <=640px */
  .pstrip {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 10px;
    margin-top: 30px;
    padding-bottom: 6px;
    scrollbar-width: none;
  }

  .pstrip::-webkit-scrollbar {
    display: none;
  }

  .pt {
    flex: 0 0 128px;
    scroll-snap-align: start;
    position: relative;
    height: 110px;
    overflow: hidden;
    background: var(--surf);
    border: 1px solid var(--line);
    cursor: pointer;
    text-align: left;
    padding: 0;
    margin: 0;
    transform: none;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .pt:hover {
    transform: translateY(-4px);
  }

  .pt img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    transition: opacity 0.3s ease;
  }

  .pt:hover img {
    opacity: 0.8;
  }

  .pt::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(14, 14, 14, 0.95), transparent 70%);
  }

  .pt span {
    position: absolute;
    z-index: 2;
    left: 12px;
    right: 12px;
    bottom: 10px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--body);
  }

  .pt.on {
    border-color: var(--lime);
    transform: none;
  }

  .pt.on:hover {
    transform: translateY(-4px);
  }

  .pt.on img {
    opacity: 0.9;
  }

  .pt.on span {
    color: var(--lime);
  }

  /* 641px - 1100px: one centred column, 4x2 tiles */
  @media (min-width: 641px) {
    .wheel-grid {
      gap: 48px;
    }

    .wheel-intro {
      display: block;
      margin-inline: auto;
    }

    .dial {
      --d: min(64vw, 480px);
      margin-block: 56px 70px;
    }

    .spin {
      bottom: -64px;
    }

    .wheel-labels :global(.nm) {
      font-size: 12.5px;
      padding: 4px 6px;
    }

    .wheel-right {
      max-width: 560px;
      margin-inline: auto;
    }

    .pstrip {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow-x: visible;
      margin-top: 30px;
      padding-bottom: 0;
    }

    .pt {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }

  /* Desktop >= 1101px: 3 columns (text | wheel | details), 8 tiles */
  @media (min-width: 1101px) {
    .wheel-grid {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: clamp(24px, 2.5vw, 48px);
      justify-items: start;
      text-align: left;
      align-items: center;
    }

    .wheel-left {
      width: 100%;
    }

    .wheel-intro {
      margin-inline: 0;
    }

    :global(.pbar) {
      display: flex;
    }

    .dial {
      --d: clamp(340px, 36vw, 520px);
      margin-block: 56px 70px;
      margin-inline: clamp(88px, 8.5vw, 116px);
      justify-self: center;
    }

    .wheel-right {
      max-width: none;
      margin-inline: 0;
      justify-items: start;
    }

    .prog-tags,
    .prog-ctl {
      justify-content: flex-start;
    }

    .pstrip {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 10px;
      margin-top: 30px;
    }
  }

  /* Landscape phones */
  @media (max-height: 500px) and (orientation: landscape) {
    .dial {
      --d: min(70vh, 320px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pt,
    .circ,
    .wheel-photo-img {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
