---
import { Image } from 'astro:assets';
import heroImg from '../../assets/photos/hero.jpg';
import Button from '../Button.astro';
import { siteConfig } from '../../data/site';
---

<header class="hero" id="top">
  <div class="hero-ph">
    <Image
      src={heroImg}
      alt="Alpha Pro Fitness gym training floor in Lingadheeranahalli, Bengaluru"
      class="bw-photo hero-img hero-photo-zoom"
      widths={[480, 768, 1200, 1600]}
      sizes="(min-width: 1024px) 58vw, (min-width: 768px) 55vw, 100vw"
      width={1280}
      height={820}
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <i class="stripe stripe-1 hero-s1 hero-stripe-slide" aria-hidden="true"></i>
  <i class="stripe stripe-2 hero-s2 hero-stripe-slide" aria-hidden="true"></i>

  <div class="container hero-txt">
    <span class="section-label hero-label">Lingadheeranahalli, Bengaluru</span>
    <h1 class="display-title hero-h1 hero-rise">
      <span class="sr-only">Alpha Pro Fitness — gym in Lingadheeranahalli, Bengaluru: </span>
      TRAIN.<br />BUILD.<br />EVOLVE.
    </h1>
    <p class="hero-sub hero-rise-delayed">
      4,500 sq.ft of iron, coaches on the floor, and A/C that actually keeps up.
    </p>
    <div class="hero-acts hero-rise-delayed">
      <Button href="/#book" variant="primary" size="default" arrow>
        Book a free trial
      </Button>
      <Button href={`tel:${siteConfig.phoneTel}`} variant="outline" size="default">
        Call {siteConfig.phoneDisplay}
      </Button>
    </div>
  </div>

  <div class="hero-badge" aria-label="Floor and amenities summary">
    <div class="badge-cell">
      <b class="tabular-numbers" data-count="4500">4,500</b>
      <span>sq.ft floor</span>
    </div>
    <div class="badge-cell">
      <b>A/C</b>
      <span>Every corner</span>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: transparent;
    padding-bottom: 50px;
  }

  .hero-ph {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 460px;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 88%);
    margin-top: 70px;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 30%;
  }

  .hero-ph::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, #161616 0%, transparent 45%);
  }

  .hero-s1 {
    right: -50px;
    top: 110px;
    width: 50px;
    height: 240px;
  }

  .hero-s2 {
    right: 24px;
    top: 150px;
    width: 18px;
    height: 160px;
  }

  .hero-txt {
    position: relative;
    z-index: 2;
    margin-top: clamp(-84px, -14vw, -56px);
    min-width: 0;
  }

  .hero-label {
    margin-bottom: 18px;
  }

  .hero-h1 {
    font-size: clamp(52px, 13vw, 140px);
    line-height: 0.95;
    color: var(--ink);
  }

  .hero-sub {
    margin-top: 20px;
    font-size: clamp(16px, 1.4vw, 20px);
    color: var(--body);
    max-width: 34ch;
    line-height: 1.45;
  }

  .hero-acts {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-acts :global(.btn) {
    width: 100%;
    justify-content: space-between;
  }

  .hero-badge {
    display: none;
  }

  /* Desktop / Tablet: >= 641px */
  @media (min-width: 641px) {
    .hero {
      height: auto;
      min-height: min(820px, 94vh);
      min-height: min(820px, 100svh);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: clamp(36px, 7vh, 80px);
      padding-bottom: clamp(36px, 7svh, 80px);
    }

    .hero-txt {
      padding-top: calc(var(--navh) + clamp(28px, 7vh, 110px));
      padding-top: calc(var(--navh) + clamp(28px, 7svh, 110px));
    }

    .hero-label {
      margin-bottom: clamp(12px, 2.4vh, 26px);
      margin-bottom: clamp(12px, 2.4svh, 26px);
    }

    .hero-h1 {
      font-size: clamp(56px, min(8.9vw, 14.5vh), 128px);
      font-size: clamp(56px, min(8.9vw, 14.5svh), 128px);
    }

    .hero-sub {
      margin-top: clamp(14px, 2.6vh, 28px);
      margin-top: clamp(14px, 2.6svh, 28px);
    }

    .hero-acts {
      margin-top: clamp(18px, 3.6vh, 40px);
      margin-top: clamp(18px, 3.6svh, 40px);
    }
  }

  /* Tablet Portrait: 768px - 1023px */
  @media (min-width: 768px) {
    .hero-ph {
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 55%;
      height: auto;
      max-height: none;
      aspect-ratio: auto;
      margin-top: 0;
      clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
    }

    .hero-ph::after {
      background: linear-gradient(
          90deg,
          #161616 0%,
          rgba(22, 22, 22, 0.45) 36%,
          transparent 68%
        ),
        linear-gradient(0deg, #161616 0%, transparent 28%);
    }

    .hero-s1 {
      right: -60px;
      top: 70px;
      width: 90px;
      height: 420px;
    }

    .hero-s2 {
      right: 120px;
      top: 120px;
      width: 34px;
      height: 300px;
    }

    .hero-txt {
      margin-top: 0;
    }

    .hero-acts {
      flex-direction: row;
      gap: 16px;
    }

    .hero-acts :global(.btn) {
      width: auto;
      justify-content: center;
    }

    .hero-badge {
      position: absolute;
      z-index: 3;
      right: var(--gutter);
      bottom: clamp(36px, 7vh, 80px);
      bottom: clamp(36px, 7svh, 80px);
      display: flex;
      background: var(--surf);
      border: 1px solid var(--line);
    }

    .badge-cell {
      padding: 16px 24px;
    }

    .badge-cell + .badge-cell {
      border-left: 1px solid var(--line);
    }

    .badge-cell b {
      display: block;
      font-family: 'Archivo Variable', Archivo, sans-serif;
      font-stretch: 125%;
      font-weight: 800;
      font-size: 26px;
      line-height: 1;
      color: var(--ink);
    }

    .badge-cell span {
      display: block;
      font-size: 13px;
      letter-spacing: 0.02em;
      color: var(--mute);
      margin-top: 6px;
    }
  }

  /* Desktop: >= 1024px */
  @media (min-width: 1024px) {
    .hero-ph {
      width: 58%;
    }

    .hero-ph::after {
      background: linear-gradient(
          90deg,
          #161616 0%,
          rgba(22, 22, 22, 0.25) 32%,
          transparent 60%
        ),
        linear-gradient(0deg, #161616 0%, transparent 28%);
    }

    .hero-badge {
      right: 80px;
    }

    .badge-cell {
      padding: 18px 26px;
    }
  }

  /* Tightening for small-height laptops */
  @media (min-width: 1025px) and (max-height: 820px) {
    .hero-ph {
      width: 54%;
    }

    .badge-cell {
      padding: 14px 20px;
    }

    .badge-cell b {
      font-size: 22px;
    }
  }

  /* Landscape phones edge case */
  @media (max-height: 500px) and (orientation: landscape) {
    .hero {
      min-height: 0;
    }

    .hero-txt {
      padding-top: 100px;
    }
  }
</style>
