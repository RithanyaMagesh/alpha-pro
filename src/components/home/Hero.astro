---
import { Image } from 'astro:assets';
import heroImg from '../../assets/photos/hero.jpg';
import Button from '../Button.astro';
import { siteConfig } from '../../data/site';
---

<header class="hero" id="top">
  <div class="hero-ph">
    <Image
      src={heroImg}
      alt="AlphaPro Fitness gym training floor"
      class="bw-photo hero-img hero-photo-zoom"
      width={1280}
      height={820}
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <i class="stripe stripe-1 hero-s1 hero-stripe-slide" aria-hidden="true"></i>
  <i class="stripe stripe-2 hero-s2 hero-stripe-slide" aria-hidden="true"></i>

  <div class="container hero-txt">
    <span class="section-label hero-label">Lingadheeranahalli, Bengaluru</span>
    <h1 class="display-title hero-h1 hero-rise">
      TRAIN.<br />BUILD.<br />EVOLVE.
    </h1>
    <p class="hero-sub hero-rise-delayed">
      4,500 sq.ft of iron, coaches on the floor, and A/C that actually keeps up.
    </p>
    <div class="hero-acts hero-rise-delayed">
      <Button href="/#book" variant="primary" size="default" arrow>
        Book a free trial
      </Button>
      <Button href={`tel:${siteConfig.phoneTel}`} variant="outline" size="default">
        Call {siteConfig.phoneDisplay}
      </Button>
    </div>
  </div>

  <div class="hero-badge" aria-label="Floor and amenities summary">
    <div class="badge-cell">
      <b class="tabular-numbers" data-count="4500">4,500</b>
      <span>sq.ft floor</span>
    </div>
    <div class="badge-cell">
      <b>A/C</b>
      <span>Every corner</span>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 820px;
    height: 820px;
    overflow: hidden;
    background: transparent;
  }

  .hero-ph {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 58%;
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 30%;
  }

  .hero-ph::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg,
        #161616 0%,
        rgba(22, 22, 22, 0.25) 32%,
        transparent 60%
      ),
      linear-gradient(0deg, #161616 0%, transparent 28%);
  }

  .hero-s1 {
    right: -60px;
    top: 70px;
    width: 90px;
    height: 420px;
  }

  .hero-s2 {
    right: 120px;
    top: 120px;
    width: 34px;
    height: 300px;
  }

  .hero-txt {
    position: relative;
    z-index: 2;
    padding-top: 190px;
  }

  .hero-label {
    margin-bottom: 24px;
  }

  .hero-h1 {
    font-size: 128px;
    line-height: 0.95;
    color: var(--ink);
  }

  .hero-sub {
    margin-top: 28px;
    font-size: 19px;
    color: var(--body);
    max-width: 34ch;
    line-height: 1.45;
  }

  .hero-acts {
    display: flex;
    gap: 16px;
    margin-top: 40px;
  }

  .hero-badge {
    position: absolute;
    z-index: 3;
    right: 80px;
    bottom: 70px;
    display: flex;
    background: var(--surf);
    border: 1px solid var(--line);
  }

  .badge-cell {
    padding: 18px 26px;
  }

  .badge-cell + .badge-cell {
    border-left: 1px solid var(--line);
  }

  .badge-cell b {
    display: block;
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-size: 26px;
    line-height: 1;
    color: var(--ink);
  }

  .badge-cell span {
    display: block;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--mute);
    margin-top: 6px;
  }

  @media (max-width: 900px) {
    .hero-h1 {
      font-size: 90px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      height: auto;
      min-height: auto;
      padding-bottom: 50px;
    }

    .hero-ph {
      position: relative;
      width: 100%;
      height: 420px;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 88%);
      margin-top: 70px;
    }

    .hero-ph::after {
      background: linear-gradient(0deg, #161616 0%, transparent 45%);
    }

    .hero-s1 {
      right: -50px;
      top: 110px;
      width: 50px;
      height: 240px;
    }

    .hero-s2 {
      right: 24px;
      top: 150px;
      width: 18px;
      height: 160px;
    }

    .hero-txt {
      padding-top: 0;
      margin-top: -90px;
    }

    .hero-h1 {
      font-size: 15.2vw;
    }

    .hero-sub {
      font-size: 16px;
      margin-top: 18px;
      max-width: 100%;
    }

    .hero-acts {
      flex-direction: column;
      margin-top: 26px;
      gap: 12px;
    }

    .hero-acts :global(.btn) {
      width: 100%;
      justify-content: space-between;
    }

    .hero-badge {
      display: none;
    }
  }
</style>
