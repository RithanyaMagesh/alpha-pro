---
import { programs } from '../../data/programs';

const stepItems = [
  {
    time: '00 – 10 MIN',
    title: 'Explore Our Space',
    desc: 'Experience our elite 4,500 sq.ft training floor and climate-controlled facility.',
  },
  {
    time: '10 – 20 MIN',
    title: 'Goal Mapping Session',
    desc: 'Define your targets, tackle past roadblocks, and map out a realistic weekly routine.',
  },
  {
    time: '20 – 50 MIN',
    title: 'Coached Trial Workout',
    desc: 'Form first. Weight later. Experience hands-on guidance where every set is watched.',
  },
  {
    time: '50 – 60 MIN',
    title: 'Your Take-Home Blueprint',
    desc: 'Get your custom training program, clear pricing, and zero pressure to sign.',
  },
];
---

<section class="sixty-section" id="sixty" aria-labelledby="sixty-h2">
  <div class="container">
    <span class="section-label">Your first hour is on us</span>

    <div class="sixty-top">
      <div class="led" id="led" aria-label="60-minute countdown clock">
        <div class="ghost" aria-hidden="true">88:88</div>
        <div class="lit" id="led-t">60:00</div>
        <span class="led-tag" aria-hidden="true">GO</span>
      </div>

      <div class="sixty-copy">
        <h2 id="sixty-h2" class="section-h2 sixty-h2">GIVE US 60 MINUTES.</h2>
        <p class="sixty-lead">
          We'll prove why we're the best gym in D Group, Andrahalli. One free hour
          with a certified coach. Walk out convinced, or walk out owing nothing.
        </p>
      </div>
    </div>

    <!-- Steps -->
    <div class="steps" aria-label="How your 60 minutes work">
      {
        stepItems.map((step) => (
          <div class="st step-item">
            <div class="tm">{step.time}</div>
            <h4 class="st-title">{step.title}</h4>
            <p class="st-desc">{step.desc}</p>
          </div>
        ))
      }
    </div>

    <!-- Booking Form Panel -->
    <form class="book booking-form" id="book" novalidate aria-label="Book your free 60 minutes">
      <div class="fl">
        <label for="b-name">Name</label>
        <input
          id="b-name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder="Your name"
          required
        />
      </div>

      <div class="fl">
        <label for="b-phone">Phone</label>
        <input
          id="b-phone"
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          placeholder="10-digit mobile"
          required
        />
      </div>

      <div class="fl">
        <label for="b-prog">Program</label>
        <select id="b-prog" name="program">
          <option value="Complete gym access" selected>
            Complete gym access
          </option>
          {
            programs.map((p) => (
              <option value={p.name}>
                {p.name}
              </option>
            ))
          }
        </select>
      </div>

      <a
        id="bk-go"
        class="btn btn-primary"
        href="https://wa.me/919071093361"
        target="_blank"
        rel="noopener"
      >
        <svg
          class="wa-ico"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 21l1.6-4.5A9 9 0 1112 21a9 9 0 01-4.4-1.2z"></path>
        </svg>
        Book on WhatsApp
      </a>
      <button type="submit" hidden aria-hidden="true" tabindex="-1"></button>

      <p class="bk-plan" id="bk-plan" hidden></p>
      <p class="bk-err" id="bk-err" role="alert" aria-live="assertive" hidden></p>
      <p class="bk-status" id="bk-status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<style>
  .sixty-section {
    position: relative;
    background: transparent;
    border-block: 1px solid var(--line);
    overflow: hidden;
    padding-block: clamp(64px, 9vw, 130px);
  }

  .sixty-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
    margin-top: 28px;
  }

  .sixty-copy {
    min-width: 0;
  }

  .sixty-h2 {
    font-size: clamp(28px, 4.2vw, 50px);
    margin-top: 0;
  }

  .sixty-lead {
    color: var(--mute);
    margin-top: 18px;
    max-width: 46ch;
    line-height: 1.55;
  }

  /* LED Clock */
  .led {
    position: relative;
    width: fit-content;
    max-width: 100%;
    background: #0b0b0b;
    border: 7px solid var(--surf);
    border-radius: 10px;
    padding: clamp(16px, 2.5vw, 28px) clamp(20px, 3.5vw, 40px)
      clamp(12px, 2vw, 22px);
    box-shadow: inset 0 0 0 1px #000, 0 30px 60px -30px #000;
  }

  .led .ghost,
  .led .lit {
    font-family: 'DSEG7', monospace;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(64px, 14vw, 160px);
    line-height: 1;
  }

  .led .ghost {
    color: var(--led-off);
  }

  .led .lit {
    position: absolute;
    left: clamp(20px, 3.5vw, 40px);
    top: clamp(16px, 2.5vw, 28px);
    color: var(--lime);
    text-shadow: 0 0 16px rgba(184, 241, 60, 0.35);
    transition: text-shadow 0.3s ease;
  }

  .led.tick .lit {
    text-shadow: 0 0 22px rgba(184, 241, 60, 0.6);
  }

  .led-tag {
    position: absolute;
    right: 14px;
    top: 8px;
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: var(--lime);
    letter-spacing: 0.1em;
  }

  /* Steps: vertical list with left progress bar on <768 */
  .steps {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: 44px;
    border-left: 1px solid var(--line);
    position: relative;
  }

  .steps::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: var(--sp, 0%);
    background: var(--lime);
    transition: height 0.2s linear;
  }

  .st {
    padding: 0 0 26px 22px;
    min-width: 0;
  }

  .st:last-child {
    padding-bottom: 0;
  }

  .st .tm {
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--lime);
    font-weight: 700;
  }

  .st-title {
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 750;
    font-size: clamp(18px, 1.8vw, 21px);
    margin-top: 10px;
    line-height: 1.15;
    color: var(--ink);
  }

  .st-desc {
    color: var(--mute);
    font-size: 14.5px;
    margin-top: 8px;
    line-height: 1.5;
  }

  /* Booking Form: 1 column on <768 */
  .book {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 44px;
    padding: clamp(20px, 3vw, 30px);
    background: var(--surf);
    border: 1px solid var(--line);
    position: relative;
    align-items: end;
  }

  .book::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--lime);
  }

  .book.flash {
    animation: flash 1.2s;
  }

  @keyframes flash {
    30% {
      box-shadow: 0 0 0 2px var(--lime);
    }
  }

  .book > .btn {
    width: 100%;
    justify-content: center;
  }

  .fl {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .fl label {
    display: block;
    font-size: 13px;
    color: var(--mute);
    margin-bottom: 8px;
    text-transform: none;
    letter-spacing: normal;
  }

  .fl input,
  .fl select {
    width: 100%;
    height: 52px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #161617;
    color: var(--ink);
    padding: 0 16px;
    font-family: inherit;
    font-size: 16px;
    border-radius: 0;
    appearance: none;
    transition: border-color 0.2s ease;
  }

  .fl select {
    background-image: linear-gradient(45deg, transparent 50%, var(--lime) 50%),
      linear-gradient(-45deg, transparent 50%, var(--lime) 50%);
    background-position: calc(100% - 20px) 22px, calc(100% - 14px) 22px;
    background-size: 6px 6px;
    background-repeat: no-repeat;
    cursor: pointer;
    padding-right: 36px;
  }

  .fl input:focus,
  .fl select:focus {
    border-color: var(--lime);
    outline: none;
  }

  .fl input[aria-invalid='true'] {
    border-color: var(--error);
  }

  .bk-plan,
  .bk-err,
  .bk-status {
    grid-column: 1 / -1;
    font-size: 14px;
    margin: 0;
  }

  .bk-plan {
    color: var(--lime);
  }

  .bk-err {
    color: var(--error);
  }

  .bk-status {
    color: #cfd0cc;
  }

  .bk-status :global(a) {
    color: var(--lime);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  .bk-status :global(a:hover) {
    filter: brightness(1.1);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    padding: 0 24px;
    background: var(--lime);
    color: #111111;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    clip-path: polygon(0 0, 100% 0, 100% 70%, calc(100% - 14px) 100%, 0 100%);
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    transform: translateY(-2px);
  }

  .wa-ico {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  @media (min-width: 641px) {
    .sixty-section {
      padding-block: clamp(56px, 11vh, 130px);
      padding-block: clamp(56px, 11svh, 130px);
    }

    .sixty-h2 {
      font-size: clamp(28px, min(3.4vw, 6.4vh), 46px);
      font-size: clamp(28px, min(3.4vw, 6.4svh), 46px);
    }

    .led {
      padding: clamp(14px, 2.6vh, 28px) clamp(20px, 2.8vw, 40px)
        clamp(12px, 2vh, 22px);
      padding: clamp(14px, 2.6svh, 28px) clamp(20px, 2.8vw, 40px)
        clamp(12px, 2svh, 22px);
    }

    .led .ghost,
    .led .lit {
      font-size: clamp(70px, min(10.5vw, 17vh), 150px);
      font-size: clamp(70px, min(10.5vw, 17svh), 150px);
    }

    .led .lit {
      left: clamp(20px, 2.8vw, 40px);
      top: clamp(14px, 2.6vh, 28px);
      top: clamp(14px, 2.6svh, 28px);
    }
  }

  /* md: 768px - 1023px (clock top, steps 2x2, form 2x2) */
  @media (min-width: 768px) {
    .led {
      border-width: 10px;
    }

    .steps {
      grid-template-columns: repeat(2, 1fr);
      border-left: none;
      border-top: 1px solid var(--line);
      margin-top: 64px;
    }

    .steps::before {
      left: 0;
      top: -1px;
      width: var(--sp, 0%);
      height: 3px;
      transition: width 0.2s linear;
    }

    .st {
      padding: 28px 24px 28px 0;
    }

    .st:nth-child(even) {
      padding-left: 24px;
      border-left: 1px solid var(--line);
    }

    .st:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .book {
      grid-template-columns: 1fr 1fr;
      margin-top: 56px;
    }

    .book > .btn {
      justify-content: center;
    }
  }

  /* lg: >= 1024px (clock & text side by side, 4 steps in a row, form 4 in a row) */
  @media (min-width: 1024px) {
    .sixty-top {
      grid-template-columns: auto 1fr;
      gap: 60px;
      margin-top: 34px;
    }

    .steps {
      grid-template-columns: repeat(4, 1fr);
      margin-top: clamp(28px, 6vh, 80px);
      margin-top: clamp(28px, 6svh, 80px);
    }

    .st {
      padding: 28px 28px 0 0;
    }

    .st + .st {
      padding-left: 28px;
      border-left: 1px solid var(--line);
    }

    .st:nth-child(n + 3) {
      border-top: none;
    }

    .book {
      grid-template-columns: 1fr 1fr 1fr auto;
      margin-top: clamp(28px, 6vh, 70px);
      margin-top: clamp(28px, 6svh, 70px);
    }

    .book > .btn {
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .steps::before,
    .led .lit {
      transition: none !important;
    }
  }
</style>
