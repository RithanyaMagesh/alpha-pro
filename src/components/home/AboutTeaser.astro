---
import { Image } from 'astro:assets';
import bodybuildingImg from '../../assets/photos/bodybuilding.jpg';
import Button from '../Button.astro';
---

<section class="about-teaser" aria-labelledby="about-teaser-h2">
  <div class="about-teaser-ph">
    <Image
      src={bodybuildingImg}
      alt="Bodybuilding and free weights floor at Alpha Pro Fitness, Bengaluru"
      class="bw-photo about-img"
      widths={[480, 768, 1200]}
      sizes="(min-width: 1024px) 42vw, 100vw"
      width={640}
      height={560}
      format="webp"
      loading="lazy"
    />
    <i class="stripe stripe-1 about-s1" aria-hidden="true"></i>
    <i class="stripe stripe-2 about-s2" aria-hidden="true"></i>
  </div>

  <div class="about-teaser-in">
    <div class="about-teaser-copy">
      <h2 id="about-teaser-h2" class="section-h2">MORE THAN A GYM.</h2>
      <p class="about-desc">
        At <b>Alpha Pro Fitness</b>, we're the neighbourhood gym that takes training
        seriously. A big, cool floor, kit that's looked after, and certified coaches
        who'll actually <b>fix your form</b> before adding weight.
      </p>
      <div class="about-cta">
        <Button href="/about#owner" variant="outline" size="card">
          Meet the owner
        </Button>
      </div>
    </div>

    <div class="about-stats" aria-label="Gym stats">
      <div class="stat-item">
        <b class="stat-number">
          <span class="tabular-numbers" data-count="4500">4,500</span><sup>SQ.FT</sup>
        </b>
        <span class="stat-label">Training floor</span>
      </div>
      <div class="stat-item">
        <b class="stat-number">8</b>
        <span class="stat-label">Ways to train</span>
      </div>
      <div class="stat-item">
        <b class="stat-number">₹0</b>
        <span class="stat-label">First workout</span>
      </div>
    </div>
  </div>
</section>

<style>
  .about-teaser {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: transparent;
  }

  .about-teaser-ph {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .about-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
  }

  .about-teaser-ph::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--bg) 0%, transparent 55%);
  }

  .about-s1 {
    left: -70px;
    top: -20px;
    width: 110px;
    height: 300px;
  }

  .about-s2 {
    left: 60px;
    top: -20px;
    width: 34px;
    height: 200px;
  }

  .about-teaser-in {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
    padding: 24px var(--gutter) clamp(56px, 8vw, 80px);
    min-width: 0;
  }

  .about-teaser-copy {
    min-width: 0;
  }

  .about-desc {
    color: var(--body);
    margin-top: 20px;
    max-width: 46ch;
    line-height: 1.6;
  }

  .about-desc b {
    color: var(--ink);
  }

  .about-cta {
    margin-top: 28px;
  }

  .about-stats {
    border-top: 1px solid var(--lime);
    padding-top: 26px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    min-width: 0;
  }

  .stat-item {
    min-width: 0;
  }

  .stat-number {
    display: block;
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(24px, 4vw, 44px);
    line-height: 1;
    color: var(--ink);
  }

  .stat-number sup {
    font-size: 0.5em;
    color: var(--steel);
    vertical-align: 0.7em;
    margin-left: 4px;
  }

  .stat-label {
    display: block;
    font-size: clamp(12px, 1.2vw, 14px);
    color: var(--mute);
    margin-top: 6px;
  }

  @media (min-width: 1024px) {
    .about-teaser {
      grid-template-columns: 42% 1fr;
      min-height: 540px;
    }

    .about-teaser-ph {
      aspect-ratio: auto;
    }

    .about-teaser-ph::after {
      background: linear-gradient(90deg, transparent 55%, var(--bg));
    }

    .about-teaser-in {
      grid-template-columns: 1fr 240px;
      gap: 48px;
      padding: 80px 60px 80px 40px;
    }

    .about-stats {
      border-top: none;
      border-left: 1px solid var(--line);
      padding-top: 0;
      padding-left: 40px;
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }

  @media (min-width: 1280px) {
    .about-teaser-in {
      grid-template-columns: 1fr 260px;
      gap: 60px;
      padding: 80px 80px 80px 40px;
    }
  }

  @media (min-width: 1025px) and (max-height: 820px) {
    .about-teaser {
      min-height: 0;
    }

    .about-teaser-in {
      padding-block: clamp(48px, 9vh, 80px);
      padding-block: clamp(48px, 9svh, 80px);
    }

    .about-stats {
      gap: clamp(18px, 3.4vh, 34px);
      gap: clamp(18px, 3.4svh, 34px);
    }

    .stat-number {
      font-size: clamp(32px, 5.4vh, 44px);
      font-size: clamp(32px, 5.4svh, 44px);
    }
  }
</style>
