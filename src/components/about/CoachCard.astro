---
import { Image } from 'astro:assets';
import type { CoachItem } from '../../data/coaches';
import Button from '../Button.astro';

import personalImg from '../../assets/photos/personal.jpg';
import coachingImg from '../../assets/photos/coaching.jpg';
import crossfitImg from '../../assets/photos/crossfit.jpg';
import aerobicsImg from '../../assets/photos/aerobics.jpg';

const photoMap: Record<string, ImageMetadata> = {
  personal: personalImg,
  coaching: coachingImg,
  crossfit: crossfitImg,
  aerobics: aerobicsImg,
};

interface Props {
  coach: CoachItem;
}

const { coach } = Astro.props;
const coachImg = photoMap[coach.photoKey]!;
---

<div
  class="coach coach-card"
  tabindex="0"
  role="region"
  aria-label={`Coach ${coach.name}, ${coach.role}`}
>
  <Image
    src={coachImg}
    alt=""
    class="bw-photo coach-img"
    style={`object-position: ${coach.photoPos}`}
    width={460}
    height={460}
    format="webp"
    loading="lazy"
  />

  <div class="nm">
    <b>{coach.name}</b>
    <span>{coach.role}</span>
  </div>

  <div class="ov coach-overlay" aria-hidden="true">
    <span class="r">{coach.role}</span>
    <b class="ov-name">{coach.name}</b>
    <span class="yrs">{coach.years} years coaching</span>

    <h5 class="ov-h5">Certifications</h5>
    <ul class="ov-certs">
      {coach.certs.map((c) => <li>{c}</li>)}
    </ul>

    <h5 class="ov-h5">Coaches</h5>
    <div class="chips">
      {coach.tags.map((t) => <span>{t}</span>)}
    </div>

    <div class="ov-btn-wrap">
      <Button
        href="/?program=Personal%20Training#book"
        variant="primary"
        size="card"
        arrow
        data-train-coach={coach.name}
      >
        Train with {coach.trainFirst}
      </Button>
    </div>
  </div>
</div>

<style>
  .coach {
    position: relative;
    height: 460px;
    overflow: hidden;
    background: var(--surf);
    border: 1px solid var(--line);
    cursor: pointer;
    transition: border-color 0.3s ease;
    outline: none;
  }

  .coach-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .coach::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(14, 14, 14, 0.95) 6%, transparent 50%);
  }

  .nm {
    position: absolute;
    z-index: 2;
    left: 20px;
    right: 20px;
    bottom: 18px;
  }

  .nm b {
    display: block;
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 115%;
    font-weight: 750;
    font-size: 20px;
    color: var(--ink);
  }

  .nm span {
    color: var(--mute);
    font-size: 13.5px;
    display: block;
    margin-top: 4px;
  }

  .ov {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: rgba(18, 18, 19, 0.94);
    padding: 26px 22px;
    display: none;
    flex-direction: column;
    animation: ovin 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes ovin {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .coach:hover,
  .coach:focus-within,
  .coach.active {
    border-color: var(--lime);
  }

  @media (hover: hover) {
    .coach:hover .ov,
    .coach:focus-within .ov {
      display: flex;
    }
    .coach:hover .coach-img {
      transform: scale(1.05);
    }
  }

  .coach.active .ov {
    display: flex;
  }

  .ov .r {
    font-size: 13px;
    color: var(--lime);
    font-weight: 700;
  }

  .ov-name {
    display: block;
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 115%;
    font-weight: 800;
    font-size: 24px;
    margin-top: 6px;
    color: var(--ink);
  }

  .ov .yrs {
    color: var(--mute);
    font-size: 13.5px;
    margin-top: 4px;
    display: block;
  }

  .ov-h5 {
    font-size: 12px;
    color: var(--mute);
    font-weight: 600;
    margin-top: 22px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ov-certs {
    list-style: none;
    margin-top: 10px;
    display: grid;
    gap: 9px;
  }

  .ov-certs li {
    display: flex;
    gap: 10px;
    font-size: 14px;
    line-height: 1.35;
    color: var(--body);
  }

  .ov-certs li::before {
    content: '';
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 2px;
    border: 1.5px solid var(--lime);
    clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
  }

  .chips span {
    font-size: 12px;
    border: 1px solid var(--line);
    padding: 5px 9px;
    color: #cfd0cc;
  }

  .ov-btn-wrap {
    margin-top: auto;
  }

  .ov-btn-wrap :global(.btn) {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .coach {
      height: 270px;
    }

    .nm {
      left: 12px;
      right: 12px;
      bottom: 12px;
    }

    .nm b {
      font-size: 15px;
    }

    .nm span {
      font-size: 12px;
    }

    .coach.active {
      order: -1;
      grid-column: 1 / -1;
      height: auto;
      min-height: 300px;
    }

    .coach.active .coach-img {
      position: absolute;
      inset: 0;
    }

    .coach.active .ov {
      position: relative;
      padding: 18px 16px;
    }
  }
</style>
