---
import { Image } from 'astro:assets';
import nutritionImg from '../../assets/photos/nutrition.jpg';
---

<section class="owner-section" id="owner" aria-labelledby="owner-h2">
  <div class="container owner-wrap">
    <div class="owner-col owner-ph">
      <Image
        src={nutritionImg}
        alt="Founder of Alpha Pro Fitness, Bengaluru"
        class="bw-photo owner-img"
        width={560}
        height={680}
        widths={[480, 768, 1200]}
        sizes="(min-width: 1024px) 460px, 100vw"
        format="webp"
        loading="lazy"
      />
      <span class="tagx">Founder</span>
    </div>

    <div class="owner-col owner-copy">
      <span class="section-label">From the owner</span>
      <h2 id="owner-h2" class="section-h2">WHY ALPHAPRO EXISTS.</h2>

      <blockquote class="owner-quote">
        “I wanted a gym where nobody waits for a bench and every beginner gets
        their form checked.”
      </blockquote>

      <div class="owner-who">
        <i aria-hidden="true"></i>
        <div>
          <b>Owner name</b>
          <span>Founder, Alpha Pro Fitness</span>
        </div>
      </div>

      <p class="story">
        Short story from the owner goes here: how AlphaPro started, why
        Lingadheeranahalli, and what they want every member to feel on their first
        day. Two or three lines in their own words.
      </p>

      <div class="facts" aria-label="Gym facts">
        <div>
          <b class="tabular-numbers">4,500</b>
          <span>sq.ft floor</span>
        </div>
        <div>
          <b>8</b>
          <span>programs</span>
        </div>
        <div>
          <b>2026</b>
          <span>est.</span>
        </div>
      </div>

      <p class="ph-note">
        Placeholder name, photo, quote and year. Swap with the owner's real details.
      </p>
    </div>
  </div>
</section>

<style>
  .owner-section {
    padding-block: clamp(64px, 9vw, 130px);
    border-bottom: 1px solid var(--line);
    background: transparent;
  }

  .owner-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(36px, 5vw, 80px);
    align-items: center;
  }

  .owner-col {
    min-width: 0;
  }

  .owner-ph {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 520px;
    overflow: hidden;
    background: var(--surf);
  }

  .owner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 20%;
  }

  .tagx {
    position: absolute;
    left: 0;
    bottom: 0;
    background: var(--lime);
    color: #111111;
    font-weight: 700;
    font-size: 13px;
    padding: 10px 16px;
  }

  .owner-quote {
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 700;
    font-style: italic;
    font-size: clamp(23px, 2.8vw, 34px);
    line-height: 1.15;
    margin-top: 22px;
    color: var(--ink);
  }

  .owner-who {
    margin-top: 30px;
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .owner-who i {
    width: 40px;
    height: 2px;
    background: var(--lime);
    flex-shrink: 0;
  }

  .owner-who b {
    display: block;
    font-size: 18px;
    color: var(--ink);
  }

  .owner-who span {
    color: var(--mute);
    font-size: 14px;
  }

  .story {
    color: var(--body);
    margin-top: 26px;
    max-width: 56ch;
    line-height: 1.6;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 3vw, 40px);
    margin-top: 34px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }

  .facts b {
    display: block;
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1;
    color: var(--ink);
  }

  .facts span {
    font-size: 13px;
    color: var(--mute);
    margin-top: 6px;
    display: block;
  }

  .ph-note {
    font-size: 12px;
    color: #6b6d70;
    margin-top: 24px;
  }

  @media (min-width: 1024px) {
    .owner-wrap {
      grid-template-columns: minmax(360px, 460px) 1fr;
    }

    .owner-ph {
      max-height: none;
      min-height: 500px;
    }
  }
</style>
