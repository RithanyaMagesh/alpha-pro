---
import { Image } from 'astro:assets';
import floorImg from '../../assets/photos/floor.jpg';
---

<header class="phero">
  <i class="stripe stripe-1 phero-s1" aria-hidden="true"></i>
  <i class="stripe stripe-2 phero-s2" aria-hidden="true"></i>

  <div class="container phero-wrap">
    <div class="phero-copy">
      <span class="section-label">About AlphaPro</span>
      <h1 class="display-title phero-h1 hero-rise">
        <span class="sr-only">About AlphaPro Fitness, a gym in D Group Employees Layout, Andrahalli, Bengaluru: </span>
        THE PEOPLE<br />BEHIND<br />THE IRON.
      </h1>
      <p class="phero-sub hero-rise-delayed">
        A neighbourhood gym in D Group Employees Layout, Andrahalli, run by
        people who lift, coach and actually show up every day.
      </p>
    </div>

    <div class="phero-ph hero-photo-zoom">
      <Image
        src={floorImg}
        alt="AlphaPro Fitness training floor in D Group Employees Layout, Andrahalli, Bengaluru"
        class="bw-photo phero-img"
        width={720}
        height={440}
        widths={[480, 768, 1200]}
        sizes="(min-width: 1024px) 45vw, 100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</header>

<style>
  .phero {
    position: relative;
    padding: clamp(110px, 15vw, 190px) 0 clamp(50px, 7vw, 90px);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: transparent;
  }

  .phero-s1 {
    right: -60px;
    top: 80px;
    width: 90px;
    height: 420px;
    z-index: 1;
  }

  .phero-s2 {
    right: 110px;
    top: 140px;
    width: 34px;
    height: 300px;
    z-index: 1;
  }

  .phero-wrap {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 60px);
    align-items: end;
  }

  .phero-copy,
  .phero-ph {
    min-width: 0;
  }

  .phero-h1 {
    font-size: clamp(44px, 10vw, 104px);
    line-height: 0.95;
    margin-top: 14px;
    color: var(--ink);
  }

  .phero-sub {
    color: var(--body);
    font-size: clamp(16px, 1.4vw, 20px);
    margin-top: 26px;
    max-width: 36ch;
    line-height: 1.5;
  }

  .phero-ph {
    position: relative;
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);
  }

  .phero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 641px) {
    .phero {
      padding: calc(var(--navh) + clamp(36px, 9vh, 100px)) 0 clamp(40px, 8vh, 90px);
      padding: calc(var(--navh) + clamp(36px, 9svh, 100px)) 0 clamp(40px, 8svh, 90px);
    }

    .phero-h1 {
      font-size: clamp(48px, min(6.8vw, 12vh), 96px);
      font-size: clamp(48px, min(6.8vw, 12svh), 96px);
    }

    .phero-ph {
      aspect-ratio: auto;
      height: clamp(260px, 50vh, 440px);
      height: clamp(260px, 50svh, 440px);
    }
  }

  @media (min-width: 1024px) {
    .phero-wrap {
      grid-template-columns: 1.05fr 0.95fr;
    }

    .phero-ph {
      clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%);
    }
  }
</style>
