---
import { siteConfig } from '../../data/site';
---

<section class="instructions-section" id="instructions" aria-labelledby="instructions-h2">
  <div class="container">
    <h2 id="instructions-h2" class="section-h2">INSTRUCTIONS.</h2>

    {
      siteConfig.membershipInstructions.length > 0 ? (
        <ul class="instructions-list">
          {siteConfig.membershipInstructions.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      ) : (
        <p class="instructions-empty">Membership instructions coming soon.</p>
      )
    }
  </div>
</section>

<style>
  .instructions-section {
    padding-block: clamp(48px, 8vw, 80px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: transparent;
  }

  .instructions-list {
    margin-top: 24px;
    padding-left: 20px;
    display: grid;
    gap: 12px;
    max-width: 64ch;
    color: var(--body);
    line-height: 1.6;
  }

  .instructions-empty {
    margin-top: 18px;
    color: var(--mute);
    font-size: 16px;
  }

  @media (min-width: 641px) {
    .instructions-section {
      padding-block: clamp(56px, 11vh, 110px);
      padding-block: clamp(56px, 11svh, 110px);
    }
  }
</style>
