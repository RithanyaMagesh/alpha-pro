---
import { compareRows } from '../../data/plans';
---

<section class="cmp-section" id="compare" aria-labelledby="compare-h2">
  <div class="container">
    <span class="section-label">Side by side</span>
    <h2 id="compare-h2" class="section-h2">COMPARE PLANS.</h2>

    <div class="compare-table-outer">
      <div class="compare-table-wrap">
        <table class="ct">
        <colgroup>
          <col />
          <col />
          <col />
          <col />
          <col class="best" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            <th scope="col">
              Monthly<small>₹2,500</small>
            </th>
            <th scope="col">
              Quarterly<small>₹5,000</small>
            </th>
            <th scope="col">
              Half-yearly<small>₹8,000</small>
            </th>
            <th scope="col">
              Annual<small>₹12,000</small>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            compareRows.map((row) => (
              <tr>
                <td>{row.feature}</td>
                {[row.monthly, row.quarterly, row.halfYearly, row.annual].map(
                  (val) => (
                    <td>
                      {val === true ? (
                        <span class="y" aria-label="Included" />
                      ) : val === false ? (
                        <span class="n" aria-label="Not included" />
                      ) : (
                        val
                      )}
                    </td>
                  )
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
      </div>
    </div>
  </div>
</section>

<style>
  .cmp-section {
    padding-block: clamp(64px, 9vw, 130px);
    border-block: 1px solid var(--line);
    background: transparent;
  }

  .compare-table-outer {
    position: relative;
    margin-top: clamp(24px, 4vw, 40px);
  }

  .compare-table-outer::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 28px;
    background: linear-gradient(90deg, transparent, rgba(22, 22, 22, 0.92));
    pointer-events: none;
    z-index: 3;
  }

  .compare-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ct {
    width: 100%;
    min-width: 580px;
    border-collapse: collapse;
    font-size: clamp(13.5px, 1.1vw, 15px);
  }

  .ct th,
  .ct td {
    padding: 14px 12px;
    border-bottom: 1px solid var(--line);
    text-align: center;
  }

  .ct th:first-child,
  .ct td:first-child {
    position: sticky;
    left: 0;
    z-index: 2;
    background: #161616;
    text-align: left;
    color: #d6d7d3;
    min-width: 145px;
    padding-right: 16px;
  }

  .ct thead th {
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
  }

  .ct thead th small {
    display: block;
    color: var(--mute);
    font-weight: 500;
    font-size: 12.5px;
    margin-top: 4px;
  }

  .ct td {
    color: var(--mute);
  }

  .ct .y {
    display: inline-block;
    width: 16px;
    height: 16px;
    background: var(--lime);
    clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%);
    vertical-align: middle;
  }

  .ct .n {
    display: inline-block;
    width: 14px;
    height: 2px;
    background: #4a4b4e;
    vertical-align: middle;
  }

  .ct col.best {
    background: rgba(184, 241, 60, 0.05);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 768px) {
    .compare-table-outer::after {
      display: none;
    }

    .ct {
      min-width: 0;
    }

    .ct th,
    .ct td {
      padding: 18px 16px;
    }

    .ct th:first-child,
    .ct td:first-child {
      position: static;
      background: transparent;
      min-width: 0;
    }
  }
</style>
