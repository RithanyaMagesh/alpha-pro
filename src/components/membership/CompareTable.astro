---
import { compareRows } from '../../data/plans';
---

<section class="cmp-section" id="compare" aria-labelledby="compare-h2">
  <div class="container">
    <span class="section-label">Side by side</span>
    <h2 id="compare-h2" class="section-h2">COMPARE PLANS.</h2>

    <div class="compare-table-wrap">
      <table class="ct">
        <colgroup>
          <col />
          <col />
          <col />
          <col />
          <col class="best" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            <th scope="col">
              Monthly<small>₹1,999</small>
            </th>
            <th scope="col">
              Quarterly<small>₹4,999</small>
            </th>
            <th scope="col">
              Half-yearly<small>₹8,999</small>
            </th>
            <th scope="col">
              Annual<small>₹14,999</small>
            </th>
          </tr>
        </thead>
        <tbody>
          {
            compareRows.map((row) => (
              <tr>
                <td>{row.feature}</td>
                {[row.monthly, row.quarterly, row.halfYearly, row.annual].map(
                  (val) => (
                    <td>
                      {val === true ? (
                        <span class="y" aria-label="Included" />
                      ) : val === false ? (
                        <span class="n" aria-label="Not included" />
                      ) : (
                        val
                      )}
                    </td>
                  )
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .cmp-section {
    padding: 110px 0;
    border-block: 1px solid var(--line);
    background: transparent;
  }

  .compare-table-wrap {
    overflow-x: auto;
    margin-top: 40px;
  }

  .ct {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .ct th,
  .ct td {
    padding: 18px 16px;
    border-bottom: 1px solid var(--line);
    text-align: center;
  }

  .ct th:first-child,
  .ct td:first-child {
    text-align: left;
    color: #d6d7d3;
  }

  .ct thead th {
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
  }

  .ct thead th small {
    display: block;
    color: var(--mute);
    font-weight: 500;
    font-size: 12.5px;
    margin-top: 4px;
  }

  .ct td {
    color: var(--mute);
  }

  .ct .y {
    display: inline-block;
    width: 16px;
    height: 16px;
    background: var(--lime);
    clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%);
    vertical-align: middle;
  }

  .ct .n {
    display: inline-block;
    width: 14px;
    height: 2px;
    background: #4a4b4e;
    vertical-align: middle;
  }

  .ct col.best {
    background: rgba(184, 241, 60, 0.05);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .cmp-section {
      padding: 70px 0;
    }

    .compare-table-wrap {
      margin-top: 24px;
    }

    .ct {
      font-size: 12.5px;
    }

    .ct th,
    .ct td {
      padding: 12px 6px;
    }

    .ct thead th small {
      display: none;
    }
  }
</style>
