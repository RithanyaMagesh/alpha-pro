---
import Button from '../Button.astro';
---

<section class="mini-section" aria-label="Free 60 minute trial offer">
  <div class="container mini-sixty-wrap">
    <div class="led led-mini" aria-label="60-minute countdown clock">
      <div class="ghost" aria-hidden="true">88:88</div>
      <div class="lit">60:00</div>
    </div>

    <div class="mini-copy">
      <h3 class="mini-h3">NOT SURE YET? GIVE US 60 MINUTES.</h3>
      <p class="mini-text">
        Free hour with a certified coach before you pay for anything.
      </p>
    </div>

    <div class="mini-act">
      <Button href="/#book" variant="primary" size="default" arrow>
        Book my 60 minutes
      </Button>
    </div>
  </div>
</section>

<style>
  .mini-section {
    padding: 70px 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
  }

  .mini-sixty-wrap {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 50px;
    align-items: center;
  }

  .led-mini {
    position: relative;
    background: #0b0b0b;
    border: 7px solid var(--surf);
    border-radius: 10px;
    padding: 16px 24px 12px;
    box-shadow: inset 0 0 0 1px #000, 0 20px 40px -20px #000;
  }

  .led-mini .ghost,
  .led-mini .lit {
    font-family: 'DSEG7', monospace;
    font-style: italic;
    font-weight: 700;
    font-size: 64px;
    line-height: 1;
  }

  .led-mini .ghost {
    color: var(--led-off);
  }

  .led-mini .lit {
    position: absolute;
    left: 24px;
    top: 16px;
    color: var(--lime);
    text-shadow: 0 0 16px rgba(184, 241, 60, 0.35);
    transition: text-shadow 0.3s ease;
  }

  .led-mini.tick .lit {
    text-shadow: 0 0 22px rgba(184, 241, 60, 0.6);
  }

  .mini-h3 {
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-style: italic;
    text-transform: uppercase;
    font-size: 30px;
    line-height: 1.05;
    color: var(--ink);
  }

  .mini-text {
    color: var(--mute);
    margin-top: 8px;
    font-size: 16px;
  }

  @media (max-width: 900px) {
    .mini-sixty-wrap {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .mini-section {
      padding: 60px 0;
    }

    .led-mini {
      width: fit-content;
    }

    .led-mini .ghost,
    .led-mini .lit {
      font-size: 48px;
    }

    .mini-h3 {
      font-size: 24px;
    }

    .mini-act :global(.btn) {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
