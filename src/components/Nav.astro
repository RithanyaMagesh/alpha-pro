---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo/logooo.png';
import Button from './Button.astro';
import { siteConfig } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function isActive(href: string): boolean {
  if (href === '/' && currentPath === '/') return true;
  if (href === '/about' && currentPath.startsWith('/about')) return true;
  if (href === '/membership' && currentPath.startsWith('/membership')) return true;
  return false;
}
---

<nav aria-label="Main Navigation">
  <div class="container nav-wrap">
    <a href="/" class="logo" aria-label="Alpha Pro Fitness home">
      <Image
        src={logoImg}
        alt="AlphaPro Fitness Logo"
        class="logo-img"
        widths={[120, 240]}
        sizes="(min-width: 1024px) 115px, 88px"
        width={1080}
        height={1080}
        format="webp"
        loading="eager"
      />
      <i class="logo-divider" aria-hidden="true"></i>
      <span class="logo-text">
        <b class="brand-top">{siteConfig.brandNameTop}</b>
        <small class="brand-bottom">{siteConfig.brandNameBottom}</small>
      </span>
    </a>

    <div class="nav-links">
      {
        siteConfig.navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { on: isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="nav-cta">
      <Button href="/#book" variant="primary" size="nav">
        Book a free trial
      </Button>
    </div>

    <button
      type="button"
      class="burger"
      id="burger"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="sheet"
    >
      <span class="burger-lines" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </button>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: env(safe-area-inset-top, 0px);
    left: 0;
    right: 0;
    z-index: 40;
    background: transparent;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  nav.solid {
    background: rgba(20, 20, 21, 0.96);
    box-shadow: 0 1px 0 var(--line);
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
    border-bottom: 1px solid var(--line);
    transition: border-bottom-color 0.3s ease;
    gap: 16px;
  }

  @media (min-width: 641px) {
    .nav-wrap {
      height: var(--navh);
    }

    .logo-img {
      height: clamp(42px, 7.4vh, 68px);
      height: clamp(42px, 7.4svh, 68px);
    }
  }

  nav.solid .nav-wrap {
    border-bottom-color: transparent;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.5vw, 16px);
    text-decoration: none;
    color: var(--ink);
    cursor: pointer;
    min-width: 0;
  }

  .logo-img {
    height: clamp(50px, 6.25vw, 85px);
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
  }

  .logo-divider {
    width: 1px;
    height: clamp(28px, 3vw, 40px);
    background: rgba(255, 255, 255, 0.35);
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .brand-top {
    display: block;
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(13px, 1.4vw, 17px);
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
  }

  .brand-bottom {
    display: block;
    font-size: clamp(9px, 0.9vw, 11.5px);
    letter-spacing: clamp(0.45em, 0.5vw, 0.62em);
    color: var(--lime);
    margin-top: 5px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-links,
  .nav-cta {
    display: none;
  }

  .burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -8px;
    background: none;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  .burger-lines {
    display: grid;
    gap: 6px;
    width: 26px;
  }

  .burger-lines i {
    display: block;
    height: 2px;
    background: var(--ink);
    transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
  }

  .burger-lines i:last-child {
    width: 60%;
    background: var(--lime);
    justify-self: end;
  }

  .burger.x .burger-lines i:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .burger.x .burger-lines i:nth-child(2) {
    opacity: 0;
  }
  .burger.x .burger-lines i:nth-child(3) {
    width: 100%;
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (min-width: 1024px) {
    .nav-wrap {
      height: 92px;
    }

    .nav-links {
      display: flex;
      gap: 38px;
      font-size: 14px;
    }

    .nav-link {
      color: #d9d9d4;
      text-decoration: none;
      position: relative;
      cursor: pointer;
      font-weight: 500;
      transition: color 0.2s ease;
      white-space: nowrap;
    }

    .nav-link:hover {
      color: var(--ink);
    }

    .nav-link.on {
      color: var(--lime);
      font-weight: 600;
    }

    .nav-link.on::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -10px;
      height: 2px;
      background: var(--lime);
    }

    .nav-cta {
      display: block;
    }

    .burger {
      display: none;
    }
  }
</style>
