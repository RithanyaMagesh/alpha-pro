---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo/logooo.png';
import { siteConfig } from '../data/site';
---

<footer>
  <div class="container footer-wrap">
    <a href="/" class="logo" aria-label="AlphaPro Fitness home">
      <Image
        src={logoImg}
        alt="AlphaPro Fitness Logo"
        class="logo-img"
        width={1080}
        height={1080}
        widths={[150, 225]}
        sizes="(min-width: 1024px) 225px, 150px"
        format="webp"
        loading="lazy"
      />
      <i class="logo-divider" aria-hidden="true"></i>
      <span class="logo-text">
        <b class="brand-top">{siteConfig.brandNameTop}</b>
        <small class="brand-bottom">{siteConfig.brandNameBottom}</small>
      </span>
    </a>

    <div class="footer-links">
      {
        siteConfig.footerLinks.map((link) => (
          <a href={link.href} class="footer-link">
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="copyright-row">
      <span>© 2026 AlphaPro Fitness. All rights reserved.</span>
      <span>D Group Employees Layout, Andrahalli, Bengaluru 560091</span>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    padding: 46px 0 30px;
    background: transparent;
  }

  .footer-wrap {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    text-align: center;
    gap: 28px;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    color: var(--ink);
  }

  .logo-img {
    height: clamp(70px, 7.5vw, 105px);
    width: auto;
    object-fit: contain;
  }

  .logo-divider {
    width: 1px;
    height: 40px;
    background: rgba(255, 255, 255, 0.35);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .brand-top {
    display: block;
    font-family: 'Archivo Variable', Archivo, sans-serif;
    font-stretch: 125%;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--ink);
  }

  .brand-bottom {
    display: block;
    font-size: 11.5px;
    letter-spacing: 0.62em;
    color: var(--lime);
    margin-top: 6px;
    font-weight: 600;
    line-height: 1;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-size: 14px;
    justify-content: center;
    color: #d9d9d4;
  }

  .footer-link {
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--lime);
  }

  .social-links {
    display: flex;
    gap: 8px;
    justify-content: center;
  }

  .social-icon {
    color: var(--ink);
    min-width: 44px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .social-icon:hover {
    color: var(--lime);
    transform: translateY(-2px);
  }

  .social-icon svg {
    width: 20px;
    height: 20px;
  }

  .copyright-row {
    grid-column: 1 / -1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #66665f;
    border-top: 1px solid var(--line);
    padding-top: 22px;
    margin-top: 6px;
  }

  @media (min-width: 1024px) {
    .footer-wrap {
      grid-template-columns: auto 1fr auto;
      justify-items: stretch;
      text-align: left;
      gap: 60px;
    }

    .footer-links {
      gap: 36px;
    }

    .social-links {
      justify-content: flex-end;
    }

    .copyright-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
