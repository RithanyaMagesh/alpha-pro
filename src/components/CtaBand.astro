---
import { Image } from 'astro:assets';
import equipImg from '../assets/photos/equip.jpg';
import Button from './Button.astro';

interface Props {
  titleTop?: string;
  titleBottom?: string;
}

const { titleTop = 'READY TO', titleBottom = 'EVOLVE?' } = Astro.props;
---

<section class="cta-band" aria-label="Call to action">
  <div class="cta-ph">
    <Image
      src={equipImg}
      alt="Strength and gym equipment at Alpha Pro Fitness, Bengaluru"
      class="bw-photo cta-img"
      widths={[480, 768, 1200]}
      sizes="(min-width: 1024px) 36vw, 100vw"
      width={720}
      height={480}
      format="webp"
      loading="lazy"
    />
  </div>

  <i class="stripe stripe-1 cta-s1" aria-hidden="true"></i>
  <i class="stripe stripe-2 cta-s2" aria-hidden="true"></i>

  <div class="container cta-in">
    <div class="cta-content">
      <h2 class="display-title cta-title">
        {titleTop}<br />{titleBottom}
      </h2>
      <p class="cta-text">
        Join Alpha Pro Fitness today and take the first step towards a stronger you.
      </p>
    </div>
    <div class="cta-act">
      <Button href="/#book" variant="primary" size="default" arrow>
        Book a free trial
      </Button>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: transparent;
    padding-bottom: clamp(44px, 6vw, 60px);
  }

  .cta-ph {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 7;
    clip-path: polygon(0 0, 100% 0, 100% 78%, 0 100%);
    overflow: hidden;
  }

  .cta-ph::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--bg) 0%, transparent 50%);
  }

  .cta-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 6s linear;
  }

  .cta-band:hover .cta-img {
    transform: scale(1.06);
  }

  .cta-s1 {
    right: -50px;
    top: -30px;
    width: 60px;
    height: 300px;
  }

  .cta-s2 {
    right: 30px;
    top: -30px;
    width: 20px;
    height: 240px;
  }

  .cta-in {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    margin-top: 24px;
  }

  .cta-content {
    min-width: 0;
  }

  .cta-title {
    font-size: clamp(36px, 5vw, 62px);
    line-height: 0.95;
    margin: 0;
  }

  .cta-text {
    color: var(--body);
    margin-top: 12px;
    max-width: 40ch;
  }

  @media (min-width: 1024px) {
    .cta-band {
      min-height: 300px;
      padding-bottom: 0;
      display: flex;
      align-items: center;
    }

    .cta-ph {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 36%;
      aspect-ratio: auto;
      clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
    }

    .cta-ph::after {
      background: linear-gradient(90deg, transparent 50%, var(--bg));
    }

    .cta-s1 {
      right: -40px;
      top: -40px;
      width: 110px;
      height: 400px;
    }

    .cta-s2 {
      right: 140px;
      top: -40px;
      width: 40px;
      height: 400px;
    }

    .cta-in {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      margin-top: 0;
      padding-left: max(40%, calc(var(--gutter) + 36%));
      padding-right: 60px;
      padding-block: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-img {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
