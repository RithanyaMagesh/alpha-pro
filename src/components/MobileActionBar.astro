---
import { siteConfig } from '../data/site';
---

<aside
  id="mobile-action-bar"
  class="mobile-bar"
  aria-label="Quick contact actions"
  hidden
>
  <div class="mobile-bar-inner">
    <a href={`tel:${siteConfig.phoneTel}`} class="bar-btn bar-call">
      Call
    </a>
    <a
      href={siteConfig.whatsAppUrl}
      target="_blank"
      rel="noopener"
      class="bar-btn bar-wa"
    >
      WhatsApp
    </a>
  </div>
</aside>

<style>
  .mobile-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 38;
    background: rgba(20, 20, 21, 0.96);
    border-top: 1px solid var(--line);
    padding: 10px max(var(--gutter), env(safe-area-inset-right, 0px))
      max(10px, env(safe-area-inset-bottom, 0px))
      max(var(--gutter), env(safe-area-inset-left, 0px));
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .mobile-bar[hidden] {
    display: none !important;
  }

  .mobile-bar-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .bar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 16px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    clip-path: polygon(0 0, 100% 0, 100% 70%, calc(100% - 12px) 100%, 0 100%);
  }

  .bar-call {
    background: var(--surf);
    color: var(--ink);
  }

  .bar-wa {
    background: var(--lime);
    color: #111111;
  }

  @media (min-width: 768px) {
    .mobile-bar {
      display: none !important;
    }
  }
</style>

<script>
  const bar = document.getElementById('mobile-action-bar');
  const hero = document.querySelector('header');
  const bookEl = document.getElementById('book');

  if (bar) {
    let pastHero = !hero;
    let bookVisible = false;

    const update = () => {
      const menuOpen = document.body.classList.contains('menu-open');
      const shouldShow = pastHero && !bookVisible && !menuOpen;
      if (shouldShow) {
        bar.removeAttribute('hidden');
      } else {
        bar.setAttribute('hidden', '');
      }
    };

    if (hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          const e = entries[0];
          if (e) {
            pastHero = !e.isIntersecting;
            update();
          }
        },
        { threshold: 0.05 }
      ).observe(hero);
    }

    if (bookEl && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          const e = entries[0];
          if (e) {
            bookVisible = e.isIntersecting;
            update();
          }
        },
        { threshold: 0.1 }
      ).observe(bookEl);
    }

    const observer = new MutationObserver(update);
    observer.observe(document.body, {
      attributes: true,
      attributeFilter: ['class'],
    });

    update();
  }
</script>
