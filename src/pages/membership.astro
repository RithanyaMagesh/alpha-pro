---
import Base from '../layouts/Base.astro';
import MemHero from '../components/membership/MemHero.astro';
import PlanCards from '../components/membership/PlanCards.astro';
import Instructions from '../components/membership/Instructions.astro';
import MiniSixty from '../components/membership/MiniSixty.astro';
import { siteConfig } from '../data/site';
---

<Base
  title={siteConfig.seo.membership.title}
  description={siteConfig.seo.membership.description}
  currentPath="/membership"
  breadcrumbLabel="Membership"
>
  <main>
    <MemHero />
    <PlanCards />
    <Instructions />
    <MiniSixty />
  </main>

  <script>
    import { initLed } from '../scripts/led';

    initLed();
  </script>
</Base>
