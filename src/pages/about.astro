---
import Base from '../layouts/Base.astro';
import AboutHero from '../components/about/AboutHero.astro';
import Owner from '../components/about/Owner.astro';
import Team from '../components/about/Team.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import { siteConfig } from '../data/site';
---

<Base
  title={siteConfig.seo.about.title}
  description={siteConfig.seo.about.description}
  currentPath="/about"
>
  <main>
    <AboutHero />
    <Owner />
    <Team />
    <FeatureStrip />
    <CtaBand titleTop="READY TO" titleBottom="EVOLVE?" />
  </main>

  <script>
    import { initCoaches } from '../scripts/coaches';

    initCoaches();
  </script>
</Base>
