---
import Base from '../layouts/Base.astro';
import AboutHero from '../components/about/AboutHero.astro';
import Owner from '../components/about/Owner.astro';
import Gallery from '../components/membership/Gallery.astro';
import Faq from '../components/membership/Faq.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import { siteConfig } from '../data/site';
---

<Base
  title={siteConfig.seo.about.title}
  description={siteConfig.seo.about.description}
  currentPath="/about"
  breadcrumbLabel="About"
>
  <main>
    <AboutHero />
    <Owner />
    <Gallery />
    <Faq />
    <FeatureStrip />
  </main>

  <script>
    import { initFaq } from '../scripts/faq';
    import { initLightbox } from '../scripts/lightbox';

    initFaq();
    initLightbox();
  </script>
</Base>
